# =============================================================================
# .env.example — modelo de variáveis de ambiente do docker compose.
# Copie para `.env` e ajuste os valores. NUNCA commite o `.env` real.
#   cp .env.example .env
# =============================================================================

# --- Aplicação / API ---
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=identity-api
JWT_KEY_ID=identity-signing-key

# Cache: "memory" (IMemoryCache) ou "redis" (IDistributedCache via Valkey).
CACHE_MODE=redis

# --- SuperAdmin de bootstrap (criado pelo DbSeeder na inicialização) ---
# E-mail fixo: sa@smartsync.com.br (usuário global, sem tenant).
# OBRIGATÓRIO — não deixe vazio; use uma senha forte em produção.
SEED_SUPERADMIN_PASSWORD=ChangeMe_SuperAdmin_2026!

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=identity
POSTGRES_PORT=5432

# --- Valkey (Redis) ---
VALKEY_PORT=6379

# --- Login social (OAuth) ---
# Credenciais criadas nos consoles Google Cloud / Meta for Developers.
# Vazio = recurso desabilitado (não configura AddGoogle/AddFacebook).
# No Google, registre o redirect URI: http://localhost:8080/signin-google
OAuth__Google__ClientId=
OAuth__Google__ClientSecret=
OAuth__Facebook__ClientId=
OAuth__Facebook__ClientSecret=

# =============================================================================
# ESTOQUE (microsserviço 2 — Etapa 24)
# =============================================================================
ESTOQUE_API_PORT=8081
ESTOQUE_POSTGRES_PORT=5433
ESTOQUE_POSTGRES_USER=postgres
ESTOQUE_POSTGRES_PASSWORD=postgres
ESTOQUE_POSTGRES_DB=estoque

# URL do Identity consumida pelo Estoque DENTRO da rede Docker.
IDENTITY_BASE_URL=http://api:8080