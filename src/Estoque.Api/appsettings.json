{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=estoque;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "http://localhost:8080",
    "Audience": "identity-api"
  },
  "Identity": {
    "BaseUrl": "http://localhost:8080",
    "ModuleSlug": "estoque",
    "JwksCacheMinutes": 720,
    "ModuleCacheSeconds": 300,
    "BranchCacheSeconds": 300
  },
  "Cache": {
    "Mode": "memory",
    "RedisConnectionString": ""
  },
  "RateLimiting": {
    "XmlImport": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
