<?xml version="1.0" encoding="UTF-8"?>
<!--
  XSD DIDÁTICO do simulador fiscal (Fiscal-9). NÃO é o leiaute oficial da NF-e:
  cobre um subconjunto estrutural (ide/emit/dest/det/total/transp/pag/infAdic)
  para exercícios locais. Integração real usa schemas/nfe/<versao>/ (oficiais).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:smartsync:fiscal:simulador"
           xmlns:tns="urn:smartsync:fiscal:simulador"
           elementFormDefault="qualified">
  <xs:element name="nfeSimulada">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="aviso" type="xs:string"/>
        <xs:element name="infNFe">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="ide" type="tns:ideType"/>
              <xs:element name="emit" type="tns:emitType"/>
              <xs:element name="dest" type="tns:destType"/>
              <xs:element name="det" type="tns:detType" maxOccurs="990"/>
              <xs:element name="total" type="tns:totalType"/>
              <xs:element name="transp" type="tns:transpType"/>
              <xs:element name="pag" type="tns:pagType"/>
              <xs:element name="infAdic" type="xs:string" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="Id" type="xs:string" use="required"/>
          </xs:complexType>
        </xs:element>
        <!-- Assinatura em namespace próprio: conteúdo conferido
             criptograficamente (lax), não por este XSD. O pipeline exige
             XML assinado antes de transmitir; o XSD aceita ambas as fases. -->
        <xs:any namespace="http://www.w3.org/2000/09/xmldsig#" processContents="lax" minOccurs="0" maxOccurs="1"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="ideType">
    <xs:sequence>
      <xs:element name="cUF" type="tns:cufType"/>
      <xs:element name="mod" type="tns:modType"/>
      <xs:element name="serie" type="xs:string"/>
      <xs:element name="nNF" type="xs:string"/>
      <xs:element name="dhEmi" type="xs:string"/>
      <xs:element name="tpAmb" type="tns:tpAmbType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="cufType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="modType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="55"/>
      <xs:enumeration value="65"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tpAmbType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="1"/>
      <xs:enumeration value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="emitType">
    <xs:sequence>
      <xs:element name="CNPJ" type="tns:cnpjType"/>
      <xs:element name="xNome" type="xs:string"/>
      <xs:element name="IE" type="xs:string" minOccurs="0"/>
      <xs:element name="CRT" type="xs:string" minOccurs="0"/>
      <xs:element name="enderEmit" type="tns:enderType"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="cnpjType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{14}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="enderType">
    <xs:sequence>
      <xs:element name="xLgr" type="xs:string"/>
      <xs:element name="nro" type="xs:string"/>
      <xs:element name="xBairro" type="xs:string"/>
      <xs:element name="cMun" type="tns:cMunType"/>
      <xs:element name="xMun" type="xs:string"/>
      <xs:element name="UF" type="xs:string"/>
      <xs:element name="CEP" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="cMunType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{7}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="destType">
    <xs:sequence>
      <xs:element name="CNPJ" type="tns:cnpjType" minOccurs="0"/>
      <xs:element name="CPF" type="tns:cpfType" minOccurs="0"/>
      <xs:element name="xNome" type="xs:string"/>
      <xs:element name="enderDest" type="tns:enderType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="cpfType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{11}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="detType">
    <xs:sequence>
      <xs:element name="prod" type="tns:prodType"/>
      <xs:element name="imposto" type="tns:impostoType"/>
    </xs:sequence>
    <xs:attribute name="nItem" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="prodType">
    <xs:sequence>
      <xs:element name="cProd" type="xs:string"/>
      <xs:element name="xProd" type="xs:string"/>
      <xs:element name="NCM" type="tns:ncmType"/>
      <xs:element name="CFOP" type="tns:cfopType"/>
      <xs:element name="uCom" type="xs:string"/>
      <xs:element name="qCom" type="xs:string"/>
      <xs:element name="vUnCom" type="xs:string"/>
      <xs:element name="vProd" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="ncmType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{8}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="cfopType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="impostoType">
    <xs:sequence>
      <xs:element name="ICMS" type="tns:icmsType"/>
      <xs:element name="IBSCBS" type="tns:ibscbsType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ibscbsType">
    <xs:sequence>
      <xs:element name="cClassTrib" type="xs:string" minOccurs="0"/>
      <xs:element name="CST" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="icmsType">
    <xs:sequence>
      <xs:element name="orig" type="xs:string" minOccurs="0"/>
      <xs:element name="CST" type="xs:string" minOccurs="0"/>
      <xs:element name="CSOSN" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="totalType">
    <xs:sequence>
      <xs:element name="vNF" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="transpType">
    <xs:sequence>
      <xs:element name="modFrete" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="pagType">
    <xs:sequence>
      <xs:element name="tPag" type="xs:string"/>
      <xs:element name="vPag" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>
</xs:schema>
